<configuration>
    <!-- Bind Zeppelin to all interfaces -->
    <property>
        <name>zeppelin.server.addr</name>
        <value>0.0.0.0</value>
    </property>

    <!-- Default port -->
    <property>
        <name>zeppelin.server.port</name>
        <value>8080</value>
    </property>

    <!-- Notebook directory -->
    <property>
        <name>zeppelin.notebook.dir</name>
        <value>/zeppelin/notebook</value>
    </property>

    <!-- Authentication Disabled -->
    <property>
        <name>zeppelin.anonymous.allowed</name>
        <value>true</value>
    </property>

    <!-- No Shiro login UI -->
    <property>
        <name>zeppelin.server.authentication</name>
        <value>none</value>
    </property>

    <!-- Log directory -->
    <property>
        <name>zeppelin.log.dir</name>
        <value>/zeppelin/logs</value>
    </property>
</configuration>
